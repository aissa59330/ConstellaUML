{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ConstellaUML",
  "version": "0.2.0",
  "identifier": "io.constella.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ConstellaUML",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Modeleur UML",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mdj"
        ],
        "name": "Projet UML",
        "mimeType": "application/x-constella-mdj",
        "description": "Projet de modélisation"
      }
    ],
    "publisher": "Aïssa Ouameur",
    "license": "GPL-3.0-or-later",
    "copyright": "© 2026 Aïssa Ouameur",
    "windows": {
      "nsis": {
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "wix": {
        "language": "fr-FR"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDRjZDRjA1Njk1RTQwQzQKUldURVFGNXBCYy8yWEloWUZmdFFzd01jYUtRYk56N2hTN3R1T2k3VG9tUXlKcGtINFdJVHBIdTgK",
      "endpoints": [
        "https://github.com/aissa59330/ConstellaUML/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
