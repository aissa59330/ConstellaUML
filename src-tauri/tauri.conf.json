{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Constella",
  "version": "0.1.0",
  "identifier": "io.constella.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Constella",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Modeleur UML",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mdj"
        ],
        "name": "Projet UML",
        "mimeType": "application/x-constella-mdj",
        "description": "Projet de modélisation"
      }
    ],
    "publisher": "Aïssa Ouameur",
    "copyright": "© 2026 Aïssa Ouameur"
  }
}